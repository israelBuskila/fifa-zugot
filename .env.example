# MongoDB Atlas SRV URI. Create a database user and allow your deployment IPs in Atlas Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fifazugot
# Required in production. One host password for the MVP.
HOST_PASSWORD=replace-with-a-long-unique-password
# Required in production. Use an independent 32+ character random string.
SESSION_SECRET=replace-with-an-independent-long-random-secret
